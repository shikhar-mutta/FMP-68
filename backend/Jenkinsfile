// ─────────────────────────────────────────────────────────────
// FMP-68 — Root CI/CD orchestrator (lives at backend/Jenkinsfile)
//
// Pattern mirrored from the reference repo
// (KetanGhungralekar/Movie-Booking-System-Microservices):
//   1. githubPush() webhook triggers this pipeline.
//   2. Detect Changes — compare HEAD with HEAD~1, map folders to
//      Jenkins job names.
//   3. Apply Infra Changes — kubectl apply backend/k8s/ on any infra diff.
//   4. Build Microservices in Parallel — `build job: <name>` for each
//      changed service.
//   5. "Nothing Changed" branch is a no-op.
//
// Jenkins job names (must be created in the Jenkins UI):
//   api-gateway-pipeline
//   auth-service-pipeline
//   users-service-pipeline
//   paths-service-pipeline
//   tracking-service-pipeline
//   notification-service-pipeline
// ─────────────────────────────────────────────────────────────

pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    triggers { githubPush() }

    environment {
        K8S_NAMESPACE = 'fmp'
    }

    stages {

        stage('Checkout') {
            steps {
                script {
                    try {
                        checkout scm
                        sh 'git log -1 --pretty=full'
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Checkout\nReason: ' + e.getMessage()
                        throw e
                    }
                }
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    try {
                        def changedFiles = sh(
                            script: "git diff --name-only HEAD~1 HEAD || git diff --name-only HEAD^ HEAD || true",
                            returnStdout: true
                        ).trim().split("\n").findAll { it }
                        echo "Changed files:\n${changedFiles.join('\n')}"

                        def serviceMap = [
                            "backend/api-gateway"          : "api-gateway-pipeline",
                            "backend/auth-service"         : "auth-service-pipeline",
                            "backend/users-service"        : "users-service-pipeline",
                            "backend/paths-service"        : "paths-service-pipeline",
                            "backend/tracking-service"     : "tracking-service-pipeline",
                            "backend/notification-service" : "notification-service-pipeline"
                        ]
                        def infraFolders = ["backend/k8s"]

                        env.MICROSERVICES_TO_BUILD = ""
                        env.INFRA_CHANGED = "false"

                        changedFiles.each { f ->
                            serviceMap.each { folder, job ->
                                if (f.startsWith(folder + "/") &&
                                    !env.MICROSERVICES_TO_BUILD.contains(job)) {
                                    env.MICROSERVICES_TO_BUILD =
                                        env.MICROSERVICES_TO_BUILD ?
                                            env.MICROSERVICES_TO_BUILD + "," + job :
                                            job
                                }
                            }
                            infraFolders.each { folder ->
                                if (f.startsWith(folder + "/")) {
                                    env.INFRA_CHANGED = "true"
                                }
                            }
                        }
                        echo "Microservices to build: ${env.MICROSERVICES_TO_BUILD ?: '<none>'}"
                        echo "Infra changed: ${env.INFRA_CHANGED}"
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Detect Changes\nReason: ' + e.getMessage()
                        throw e
                    }
                }
            }
        }

        stage('Apply Infra Changes') {
            when { expression { env.INFRA_CHANGED == "true" } }
            steps {
                script {
                    try {
                        echo "Applying K8s manifest updates..."
                        sh "kubectl apply -f backend/k8s/ --recursive -n ${K8S_NAMESPACE}"
                        sh "kubectl get pods,svc,hpa -n ${K8S_NAMESPACE}"
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Apply Infra\nReason: kubectl apply failed. Check manifests in backend/k8s/'
                        throw e
                    }
                }
            }
        }

        stage('Build Microservices in Parallel') {
            when { expression { env.MICROSERVICES_TO_BUILD?.trim() } }
            steps {
                script {
                    def jobs = env.MICROSERVICES_TO_BUILD.split(",")
                    def parallelBuilds = [:]
                    jobs.each { jobName ->
                        parallelBuilds[jobName] = {
                            try {
                                build job: jobName, wait: true,
                                    parameters: [
                                        string(name: 'IMAGE_TAG', value: "main-${env.BUILD_NUMBER}")
                                    ]
                            } catch (Exception e) {
                                currentBuild.description =
                                    (currentBuild.description ?: '') +
                                    "\nFailed: ${jobName} — ${e.getMessage()}"
                                throw e
                            }
                        }
                    }
                    parallel parallelBuilds
                }
            }
        }

        stage('Nothing Changed') {
            when {
                expression {
                    !env.MICROSERVICES_TO_BUILD?.trim() && env.INFRA_CHANGED == "false"
                }
            }
            steps {
                echo "No backend or infra changes detected in this commit. Exiting cleanly."
            }
        }
    }

    post {
        success {
            echo "✅ Root pipeline #${env.BUILD_NUMBER} succeeded."
            mail to: 'shikharmutta67@gmail.com',
                 subject: "SUCCESS: FMP-68 Root Pipeline - Build #${env.BUILD_NUMBER}",
                 body: "Built services: ${env.MICROSERVICES_TO_BUILD ?: '<none>'}\nInfra changed: ${env.INFRA_CHANGED}\n\nJob: ${env.JOB_NAME}\nURL: ${env.BUILD_URL}"
        }
        failure {
            script {
                def info = currentBuild.description ?: 'Unknown failure'
                mail to: 'shikharmutta67@gmail.com',
                     subject: "FAILURE: FMP-68 Root Pipeline - Build #${env.BUILD_NUMBER}",
                     body: "Pipeline failed.\n\n${info}\n\nConsole: ${env.BUILD_URL}console"
            }
        }
        always {
            sh 'docker image prune -f || true'
        }
    }
}
