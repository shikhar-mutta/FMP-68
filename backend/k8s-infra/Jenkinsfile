// ─────────────────────────────────────────────────────────────
// fmp-infra — cluster-manifest CI pipeline
// Jenkins job name: fmp-infra
// Replaces the "Apply Infra Changes" stage of the old orchestrator.
// Triggered by: Generic Webhook Trigger plugin — GitHub push under backend/k8s/
// ─────────────────────────────────────────────────────────────

pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds(abortPrevious: true)
    }

    // Generic Webhook Trigger — fires ONLY when a push to main touches
    // a file under backend/k8s/.
    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'ref',      value: '$.ref'],
                [key: 'modified', value: '$.commits[*].modified[*]'],
                [key: 'added',    value: '$.commits[*].added[*]'],
                [key: 'removed',  value: '$.commits[*].removed[*]']
            ],
            causeString:               'Push touched backend/k8s/',
            token:                     'fmp-webhook-token',
            printContributedVariables: true,
            printPostContent:          false,
            regexpFilterText:          '$ref|$modified|$added|$removed',
            regexpFilterExpression:    '^refs/heads/main.*backend/k8s/.*$'
        )
    }

    environment {
        K8S_NAMESPACE = 'fmp'
    }

    stages {

        stage('Checkout') {
            steps {
                script {
                    try {
                        checkout scm
                        sh 'git log -1 --pretty=full'
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Checkout\nReason: ' + e.getMessage()
                        throw e
                    }
                }
            }
        }

        stage('Ensure Cluster') {
            steps {
                script {
                    try {
                        sh '''
                            if ! minikube status --format='{{.Host}}' 2>/dev/null | grep -q Running; then
                                echo "Minikube not running — starting…"
                                minikube start --driver=docker
                                minikube update-context
                            else
                                echo "Minikube already running."
                            fi
                            kubectl get namespace fmp >/dev/null 2>&1 || \
                                kubectl apply -f backend/k8s/namespace.yaml
                        '''
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Ensure Cluster\nReason: ' + e.getMessage()
                        throw e
                    }
                }
            }
        }

        stage('Ensure Secrets') {
            steps {
                script {
                    try {
                        // backend/k8s/vault/vault.yaml is gitignored (contains the
                        // raw OAuth client secret + JWT secret inline). Instead of
                        // running the Vault → fmp-secret bridge from start-k8s.sh
                        // inside CI, we create the secret directly from Jenkins
                        // text credentials. Same shape (5 keys), same downstream
                        // consumers (every fmp-* deployment's envFrom: fmp-secret).
                        // Idempotent — `kubectl apply` of a dry-run secret YAML.
                        withCredentials([
                            string(credentialsId: 'fmp-jwt-secret',          variable: 'JWT_SECRET'),
                            string(credentialsId: 'fmp-google-client-id',    variable: 'GOOGLE_CLIENT_ID'),
                            string(credentialsId: 'fmp-google-client-secret',variable: 'GOOGLE_CLIENT_SECRET')
                        ]) {
                            sh '''
                                kubectl create secret generic fmp-secret -n fmp \
                                    --from-literal=JWT_SECRET="$JWT_SECRET" \
                                    --from-literal=GOOGLE_CLIENT_ID="$GOOGLE_CLIENT_ID" \
                                    --from-literal=GOOGLE_CLIENT_SECRET="$GOOGLE_CLIENT_SECRET" \
                                    --from-literal=DATABASE_URL="mongodb://mongo-external:27017/fmp68?replicaSet=rs0&directConnection=true" \
                                    --from-literal=RABBITMQ_URL="amqp://guest:guest@rabbitmq.fmp.svc.cluster.local:5672" \
                                    --dry-run=client -o yaml | kubectl apply -f -
                            '''
                        }
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Ensure Secrets\nReason: ' + e.getMessage()
                        throw e
                    }
                }
            }
        }

        stage('Apply K8s Manifests') {
            steps {
                script {
                    try {
                        // Two-pass apply (same pattern as start-k8s.sh:445/455):
                        // Pass 1 — namespaces only. Recursive apply sorts files
                        // alphabetically, so elk/elasticsearch.yaml would race
                        // ahead of elk/namespace.yaml and fail with
                        // "namespaces 'elk' not found". Apply namespaces first
                        // to guarantee they exist before any namespaced resource
                        // lands. Idempotent — no-op when they already exist.
                        // (vault namespace is embedded as the first doc in
                        // backend/k8s/vault/vault.yaml, so it's already handled
                        // in-order by Pass 2.)
                        sh '''
                            kubectl apply -f backend/k8s/namespace.yaml
                            kubectl apply -f backend/k8s/elk/namespace.yaml
                        '''
                        // Pass 2 — everything (services, deployments, jobs, HPAs).
                        sh 'kubectl apply -f backend/k8s/ --recursive'
                        sh "kubectl get pods,svc,hpa -n ${K8S_NAMESPACE}"
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Apply K8s\nReason: kubectl apply failed.'
                        throw e
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ fmp-infra build #${env.BUILD_NUMBER} applied backend/k8s/ to namespace ${K8S_NAMESPACE}"
        }
        failure {
            echo "✘ fmp-infra build #${env.BUILD_NUMBER} failed: ${currentBuild.description ?: 'Unknown failure'}"
        }
    }
}
