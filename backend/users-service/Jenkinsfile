// ─────────────────────────────────────────────────────────────
// fmp-users-service — per-service CI/CD pipeline
// Jenkins job name: fmp-users-service
// ─────────────────────────────────────────────────────────────

pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 25, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        // Abort in-progress run on new commit — see backend/Jenkinsfile for rationale.
        disableConcurrentBuilds(abortPrevious: true)
        // Serialise across all fmp-* service jobs: only one full build runs at a
        // time so Docker build, image load, and kubectl rollout never race for the
        // single Minikube node or Docker daemon.
        lock(resource: 'fmp-sequential-build')
    }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: "main-${env.BUILD_NUMBER}",
            description: 'Docker image tag for this build'
        )
    }

    // Generic Webhook Trigger — fires this job ONLY when a push to main
    // touches a file under backend/users-service/. No orchestrator job
    // needed; GitHub posts once, every fmp-* job filters independently.
    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'ref',      value: '$.ref'],
                [key: 'modified', value: '$.commits[*].modified[*]'],
                [key: 'added',    value: '$.commits[*].added[*]'],
                [key: 'removed',  value: '$.commits[*].removed[*]']
            ],
            causeString:               'Push touched backend/users-service/',
            token:                     'fmp-webhook-token',
            printContributedVariables: true,
            printPostContent:          false,
            regexpFilterText:          '$ref|$modified|$added|$removed',
            regexpFilterExpression:    '^refs/heads/main.*backend/users-service/.*$'
        )
    }

    environment {
        SERVICE_NAME    = 'users-service'
        SERVICE_PORT    = '4002'
        DOCKER_REPO     = 'shikhar68'
        K8S_NAMESPACE   = 'fmp'
        IMAGE_LOCAL     = "fmp-${SERVICE_NAME}:${params.IMAGE_TAG}"
        IMAGE_REMOTE    = "${DOCKER_REPO}/fmp-${SERVICE_NAME}:${params.IMAGE_TAG}"
    }

    stages {

        stage('Checkout') {
            steps {
                script {
                    try {
                        checkout scm
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Checkout\nReason: ' + e.getMessage()
                        throw e
                    }
                }
            }
        }

        stage('Install & Test') {
            steps {
                script {
                    try {
                        dir("backend/${SERVICE_NAME}") {
                            sh 'node --version && npm --version'
                            sh 'npm install --no-audit --no-fund'
                            // Regenerate Prisma client against current schema.prisma.
                            sh 'npx prisma generate || true'
                            // Skip prisma.service.spec — it's an integration test that
                            // needs a real DATABASE_URL; CI doesn't provide one yet.
                            sh 'npm test -- --coverage --testPathIgnorePatterns=prisma.service.spec'
                        }
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Install & Test\nReason: npm install or npm test failed.'
                        throw e
                    }
                }
            }
        }

        stage('Docker Build') {
            options { timeout(time: 15, unit: 'MINUTES') }
            steps {
                script {
                    try {
                        sh 'docker info > /dev/null 2>&1'
                        dir("backend/${SERVICE_NAME}") {
                            sh "docker build -t ${IMAGE_LOCAL} -t fmp-${SERVICE_NAME}:local ."
                        }
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Docker Build\nReason: Image build failed.'
                        throw e
                    }
                }
            }
        }

        stage('Docker Push') {
            when { expression { currentBuild.currentResult == 'SUCCESS' || currentBuild.currentResult == null } }
            steps {
                script {
                    try {
                        withCredentials([usernamePassword(
                            credentialsId: 'docker-hub-credentials',
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_PASS'
                        )]) {
                            sh '''
                                echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                                docker tag ${IMAGE_LOCAL} ${IMAGE_REMOTE}
                                docker push ${IMAGE_REMOTE}
                                docker logout
                            '''
                        }
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Docker Push\nReason: Docker Hub push failed.'
                        throw e
                    }
                }
            }
        }

        stage('Ensure Cluster') {
            steps {
                script {
                    try {
                        sh '''
                            if ! minikube status --format='{{.Host}}' 2>/dev/null | grep -q Running; then
                                echo "Minikube not running — starting…"
                                minikube start --driver=docker
                                minikube update-context
                            else
                                echo "Minikube already running."
                            fi
                            kubectl get namespace fmp >/dev/null 2>&1 || \
                                kubectl apply -f backend/k8s/namespace.yaml
                        '''
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Ensure Cluster\nReason: ' + e.getMessage()
                        throw e
                    }
                }
            }
        }

        stage('Deploy to Minikube') {
            when { expression { currentBuild.currentResult == 'SUCCESS' || currentBuild.currentResult == null } }
            steps {
                script {
                    try {
                        // Ensure the fmp namespace exists before applying namespace-scoped
                        // manifests. Idempotent: no-op on existing clusters, self-heals
                        // on fresh Minikube. Independently safe even if the orchestrator's
                        // "Apply Infra Changes" stage didn't run (e.g. no backend/k8s/ diff).
                        sh "kubectl apply -f backend/k8s/namespace.yaml"
                        sh "kubectl apply -f backend/k8s/${SERVICE_NAME}/"
                        sh "minikube image load ${IMAGE_REMOTE} --overwrite"
                        sh """
                            kubectl set image deployment/${SERVICE_NAME} \
                                ${SERVICE_NAME}=${IMAGE_REMOTE} \
                                -n ${K8S_NAMESPACE}
                            kubectl rollout status deployment/${SERVICE_NAME} \
                                -n ${K8S_NAMESPACE} --timeout=180s
                        """
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Deploy to Minikube\nReason: kubectl/minikube command failed.'
                        throw e
                    }
                }
            }
        }

        stage('Ansible Verify') {
            when { expression { currentBuild.currentResult == 'SUCCESS' || currentBuild.currentResult == null } }
            steps {
                script {
                    try {
                        sh """
                            ansible-playbook \
                                -i backend/ansible/inventory.ini \
                                -e service_name=${SERVICE_NAME} \
                                backend/ansible/verify.yml
                        """
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Ansible Verify\nReason: ' + e.getMessage()
                        throw e
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ ${SERVICE_NAME} build #${env.BUILD_NUMBER} deployed as ${IMAGE_LOCAL}"
        }
        failure {
            echo "✘ ${SERVICE_NAME} build #${env.BUILD_NUMBER} failed: ${currentBuild.description ?: 'Unknown failure'}"
        }
        always {
            script {
                if (env.IMAGE_LOCAL && env.IMAGE_REMOTE) {
                    sh """
                        docker rmi -f ${env.IMAGE_LOCAL} ${env.IMAGE_REMOTE} 2>/dev/null || true
                        ids=\$(docker images fmp-${env.SERVICE_NAME} -q; docker images ${env.DOCKER_REPO}/fmp-${env.SERVICE_NAME} -q)
                        [ -n "\$ids" ] && docker rmi -f \$ids 2>/dev/null || true
                    """
                } else {
                    echo 'Skipping image cleanup — build aborted before environment was set.'
                }
            }
        }
    }
}
