// ─────────────────────────────────────────────────────────────
// fmp-users-service — per-service CI/CD pipeline
// Jenkins job name: users-service-pipeline
// ─────────────────────────────────────────────────────────────

pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 25, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    triggers { githubPush() }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: "main-${env.BUILD_NUMBER}",
            description: 'Docker image tag for this build'
        )
    }

    environment {
        SERVICE_NAME    = 'users-service'
        SERVICE_PORT    = '4002'
        DOCKER_REPO     = 'shikharmutta'
        K8S_NAMESPACE   = 'fmp'
        IMAGE_LOCAL     = "fmp-${SERVICE_NAME}:${params.IMAGE_TAG}"
        IMAGE_REMOTE    = "${DOCKER_REPO}/fmp-${SERVICE_NAME}:${params.IMAGE_TAG}"
    }

    stages {

        stage('Checkout') {
            steps {
                script {
                    try {
                        checkout scm
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Checkout\nReason: ' + e.getMessage()
                        throw e
                    }
                }
            }
        }

        stage('Check for Changes') {
            steps {
                script {
                    try {
                        def changed = sh(
                            script: "git diff --name-only HEAD~1 HEAD | grep '^backend/${SERVICE_NAME}/' || true",
                            returnStdout: true
                        ).trim()
                        if (changed == "") {
                            echo "No changes in backend/${SERVICE_NAME}/ — skipping build."
                            currentBuild.result = 'NOT_BUILT'
                            error("Skipping build for ${SERVICE_NAME}")
                        }
                        echo "Changed files in backend/${SERVICE_NAME}:\n${changed}"
                    } catch (hudson.AbortException ae) {
                        throw ae
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Check for Changes\nReason: ' + e.getMessage()
                        throw e
                    }
                }
            }
        }

        stage('Install & Test') {
            steps {
                script {
                    try {
                        dir("backend/${SERVICE_NAME}") {
                            sh 'node --version && npm --version'
                            sh 'npm install --no-audit --no-fund'
                            sh 'npm test -- --passWithNoTests --coverage || true'
                        }
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Install & Test\nReason: npm install or npm test failed.'
                        throw e
                    }
                }
            }
        }

        stage('Docker Build') {
            options { timeout(time: 15, unit: 'MINUTES') }
            steps {
                script {
                    try {
                        sh 'docker info > /dev/null 2>&1'
                        dir("backend/${SERVICE_NAME}") {
                            sh "docker build -t ${IMAGE_LOCAL} -t fmp-${SERVICE_NAME}:local ."
                        }
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Docker Build\nReason: Image build failed.'
                        throw e
                    }
                }
            }
        }

        stage('Docker Push') {
            steps {
                script {
                    try {
                        withCredentials([usernamePassword(
                            credentialsId: 'docker-hub-credentials',
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_PASS'
                        )]) {
                            sh '''
                                echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                                docker tag ${IMAGE_LOCAL} ${IMAGE_REMOTE}
                                docker push ${IMAGE_REMOTE}
                                docker logout
                            '''
                        }
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Docker Push\nReason: Docker Hub push failed.'
                        throw e
                    }
                }
            }
        }

        stage('Deploy to Minikube') {
            steps {
                script {
                    try {
                        sh """
                            minikube image load ${IMAGE_LOCAL} || true
                            kubectl set image deployment/${SERVICE_NAME} \
                                ${SERVICE_NAME}=${IMAGE_LOCAL} \
                                -n ${K8S_NAMESPACE}
                            kubectl rollout status deployment/${SERVICE_NAME} \
                                -n ${K8S_NAMESPACE} --timeout=180s
                        """
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Deploy to Minikube\nReason: kubectl/minikube command failed.'
                        throw e
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ ${SERVICE_NAME} build #${env.BUILD_NUMBER} deployed as ${IMAGE_LOCAL}"
            mail to: 'shikharmutta67@gmail.com',
                 subject: "SUCCESS: ${SERVICE_NAME} Pipeline - Build #${env.BUILD_NUMBER}",
                 body: "Service: ${SERVICE_NAME}\nImage: ${IMAGE_LOCAL}\nRemote: ${IMAGE_REMOTE}\n\nJob: ${env.JOB_NAME}\nURL: ${env.BUILD_URL}"
        }
        failure {
            script {
                def info = currentBuild.description ?: 'Unknown failure'
                mail to: 'shikharmutta67@gmail.com',
                     subject: "FAILURE: ${SERVICE_NAME} Pipeline - Build #${env.BUILD_NUMBER}",
                     body: "Service: ${SERVICE_NAME}\n\n${info}\n\nConsole: ${env.BUILD_URL}console"
            }
        }
        always {
            sh 'docker image prune -f || true'
        }
    }
}
