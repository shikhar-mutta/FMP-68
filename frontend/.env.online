# ─────────────────────────────────────────────────────────────────────
# Online mode — frontend override values
# Loaded by docker-compose.online*.yml at parse time via --env-file.
#
# REACT_APP_API_URL is set to the FULL public URL (not empty).
# Reason: parts of the frontend (api.js, socketService.js,
# DashboardPage.js) use `||` instead of `??` and therefore treat an
# empty string as falsy, falling back to http://localhost:4000.
# Using the ngrok URL produces absolute URLs that the browser sends
# to the same origin → CRA dev proxy (watch) or nginx (prod) routes
# them to the api-gateway container.
# ─────────────────────────────────────────────────────────────────────
ONLINE_REACT_APP_API_URL=https://patriarchic-georgianne-acetimetric.ngrok-free.dev
ONLINE_PUBLIC_URL=https://patriarchic-georgianne-acetimetric.ngrok-free.dev
