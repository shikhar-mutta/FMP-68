# ─────────────────────────────────────────────────────────────
# Frontend env — production / container build
#
# CRA's `npm run build` sets NODE_ENV=production and reads this file
# in preference to .env. Variables here are inlined into the static
# JS bundle, so the URL is fixed for any given image build.
#
# Browser hits the api-gateway directly via the kubectl port-forward
# that start-k8s.sh sets up on host port 4000.
# ─────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:4000
GENERATE_SOURCEMAP=false
