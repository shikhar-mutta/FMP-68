# ─────────────────────────────────────────────────────────────
# Frontend env — production / container build
#
# CRA's `npm run build` sets NODE_ENV=production and reads this file
# in preference to .env. Variables here are inlined into the static
# JS bundle, so the URL is fixed for any given image build.
#
# We point at the Ingress host. In the cluster:
#   /              → frontend Service     (this app, served by nginx)
#   /auth /users /paths /follow-requests /socket.io
#                  → api-gateway Service
#
# Both routes live on the same host (fmp.local) so the browser stays
# same-origin — no CORS, cookies/JWT just work.
# ─────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://fmp.local
GENERATE_SOURCEMAP=false
