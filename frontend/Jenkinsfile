// ─────────────────────────────────────────────────────────────
// fmp-frontend — standalone CI/CD pipeline
// Jenkins job name: fmp-frontend
// Triggered by:
//   - Generic Webhook Trigger plugin — GitHub push under frontend/
// ─────────────────────────────────────────────────────────────

pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 25, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        // Abort in-progress run on new commit — see backend/Jenkinsfile for rationale.
        disableConcurrentBuilds(abortPrevious: true)
    }

    // Generic Webhook Trigger — fires this job ONLY when a push to main
    // touches a file under frontend/. No orchestrator job needed; GitHub
    // posts once, every fmp-* job filters independently.
    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'ref',      value: '$.ref'],
                [key: 'modified', value: '$.commits[*].modified[*]'],
                [key: 'added',    value: '$.commits[*].added[*]'],
                [key: 'removed',  value: '$.commits[*].removed[*]']
            ],
            causeString:               'Push touched frontend/',
            token:                     'fmp-webhook-token',
            printContributedVariables: true,
            printPostContent:          false,
            regexpFilterText:          '$ref|$modified|$added|$removed',
            regexpFilterExpression:    '^refs/heads/main.*frontend/.*$'
        )
    }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: "main-${env.BUILD_NUMBER}",
            description: 'Docker image tag for this build'
        )
    }

    environment {
        SERVICE_NAME    = 'frontend'
        DOCKER_REPO     = 'shikhar68'
        K8S_NAMESPACE   = 'fmp'
        IMAGE_LOCAL     = "fmp-${SERVICE_NAME}:${params.IMAGE_TAG}"
        IMAGE_REMOTE    = "${DOCKER_REPO}/fmp-${SERVICE_NAME}:${params.IMAGE_TAG}"
    }

    stages {

        stage('Checkout') {
            steps {
                script {
                    try {
                        checkout scm
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Checkout\nReason: ' + e.getMessage()
                        throw e
                    }
                }
            }
        }

        stage('Install & Test') {
            steps {
                script {
                    try {
                        dir('frontend') {
                            sh 'node --version && npm --version'
                            sh 'npm install --no-audit --no-fund'
                            // CI=true ensures jest runs once (no watch) and exits with a non-zero code on failure.
                            sh 'CI=true npm test -- --watchAll=false --coverage'
                        }
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Install & Test\nReason: npm install or npm test failed.'
                        throw e
                    }
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    try {
                        dir('frontend') {
                            // CI=false so React-Scripts treats build warnings as warnings, not errors.
                            // GENERATE_SOURCEMAP=false keeps the bundle small.
                            sh 'CI=false GENERATE_SOURCEMAP=false npm run build'
                        }
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Build\nReason: npm run build failed.'
                        throw e
                    }
                }
            }
        }

        stage('Docker Build') {
            options { timeout(time: 15, unit: 'MINUTES') }
            steps {
                script {
                    try {
                        sh 'docker info > /dev/null 2>&1'
                        dir('frontend') {
                            sh "docker build -t ${IMAGE_LOCAL} -t fmp-${SERVICE_NAME}:local ."
                        }
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Docker Build\nReason: Image build failed.'
                        throw e
                    }
                }
            }
        }

        stage('Docker Push') {
            when { expression { currentBuild.currentResult == 'SUCCESS' || currentBuild.currentResult == null } }
            steps {
                script {
                    try {
                        withCredentials([usernamePassword(
                            credentialsId: 'docker-hub-credentials',
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_PASS'
                        )]) {
                            sh '''
                                echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                                docker tag ${IMAGE_LOCAL} ${IMAGE_REMOTE}
                                docker push ${IMAGE_REMOTE}
                                docker logout
                            '''
                        }
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Docker Push\nReason: Docker Hub push failed.'
                        throw e
                    }
                }
            }
        }

        stage('Deploy to Minikube') {
            when { expression { currentBuild.currentResult == 'SUCCESS' || currentBuild.currentResult == null } }
            steps {
                script {
                    try {
                        // Ensure the fmp namespace exists before applying any namespace-scoped
                        // manifests. kubectl apply is idempotent (no-op on existing clusters)
                        // and self-heals on a fresh Minikube — fixes the "namespaces 'fmp'
                        // not found" failure that bricked builds #34–#46.
                        sh "kubectl apply -f backend/k8s/namespace.yaml"
                        // Apply frontend k8s manifests first (idempotent — creates Deployment/Service/HPA on first run, no-op on subsequent). The orchestrator's "Apply Infra Changes" stage only covers backend/k8s/, so frontend/k8s/ must be applied by this pipeline. Without this, kubectl set image fails with "deployment not found" on a fresh cluster.
                        sh "kubectl apply -f frontend/k8s/"
                        sh """
                            kubectl set image deployment/${SERVICE_NAME} \
                                ${SERVICE_NAME}=${IMAGE_REMOTE} \
                                -n ${K8S_NAMESPACE}
                            kubectl rollout status deployment/${SERVICE_NAME} \
                                -n ${K8S_NAMESPACE} --timeout=180s
                        """
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Deploy to Minikube\nReason: kubectl/minikube command failed.'
                        throw e
                    }
                }
            }
        }

        stage('Ansible Verify') {
            when { expression { currentBuild.currentResult == 'SUCCESS' || currentBuild.currentResult == null } }
            steps {
                script {
                    try {
                        sh '''
                            ansible-playbook \
                                -i backend/ansible/inventory.ini \
                                backend/ansible/verify.yml
                        '''
                    } catch (Exception e) {
                        currentBuild.description = 'Failed Stage: Ansible Verify\nReason: ' + e.getMessage()
                        throw e
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ ${SERVICE_NAME} build #${env.BUILD_NUMBER} deployed as ${IMAGE_LOCAL}"
        }
        failure {
            echo "✘ ${SERVICE_NAME} build #${env.BUILD_NUMBER} failed: ${currentBuild.description ?: 'Unknown failure'}"
        }
        always {
            sh """
                # Remove this build's tagged images (local + remote-tagged)
                docker rmi -f ${IMAGE_LOCAL} ${IMAGE_REMOTE} 2>/dev/null || true
                # Remove any other fmp-${SERVICE_NAME} images that earlier builds left behind
                ids=\$(docker images fmp-${SERVICE_NAME} -q; docker images ${DOCKER_REPO}/fmp-${SERVICE_NAME} -q)
                [ -n "\$ids" ] && docker rmi -f \$ids 2>/dev/null || true
                # NOTE: global `docker image prune` / `docker builder prune` deliberately omitted here.
                # Parallel sibling builds share the daemon's cache; pruning here destroys layers/snapshots
                # other in-flight builds depend on (containerd CreateDiff / "No such image" errors).
                # The orchestrator's post.always runs the global prune once after all children finish.
            """
        }
    }
}
